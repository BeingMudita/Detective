# ─── Internet Detective · environment ───────────────────────────────────────
# Copy this file to `.env`, then run: docker compose up
#
# NOTHING in here requires an account, an API key, or any paid service.
# Every value has a safe local default. Recurring cost: ₹0.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres (consumed by the postgres container and the backend)
POSTGRES_USER=detective
POSTGRES_PASSWORD=detective
POSTGRES_DB=detective

# Backend
ENV=development
# In Docker this is overridden to use the `postgres` service host automatically.
# For bare-metal dev (no Docker), change `postgres` -> `localhost`.
DATABASE_URL=postgresql+asyncpg://detective:detective@postgres:5432/detective

# Leave SECRET_KEY blank: the backend generates and persists one locally
# (backend/.secret_key) on first run, so tokens survive restarts. No key service.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Auth rate limiting (in-process, per node — no Redis needed)
AUTH_RATE_LIMIT=15
AUTH_RATE_WINDOW_SECONDS=60

# Seed accounts (development only — change before any real deployment)
SEED_ADMIN_EMAIL=admin@aurelia.example
SEED_ADMIN_PASSWORD=Detective#001
SEED_PLAYER_EMAIL=player@aurelia.example
SEED_PLAYER_PASSWORD=Investigate#001

# Frontend: where the Vite dev server proxies /api. In Docker this is set to
# http://backend:8000 by compose. For bare-metal dev, use http://localhost:8000.
VITE_PROXY_TARGET=http://localhost:8000
